@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

SHOW_PERSON_OUTLINE()

title Diagrama de Contêiner (C4 - Nível 2) - Diário de Bordo (Gestão Agro)

Person(operador, "Produtor / Operador", "Usuário responsável por registrar horas, abastecimentos e acompanhar manutenções.")

System_Boundary(sistema_agro, "Sistema Diário de Bordo") {
    Container(web_app, "Interface Web", "HTML, CSS, JavaScript", "Telas para lançamento de horímetro, consumo de combustível e visualização de alertas.")
    Container(backend, "Servidor Backend", "Python / Flask", "Processa as requisições HTTP, executa a lógica de negócios e valida as regras de manutenção e custos.")
    ContainerDb(database, "Armazenamento de Dados", "SQLite / Relacional", "Armazena cadastros, registros de horas trabalhadas, consumo e histórico de manutenção.")
}

' Relacionamentos
Rel(operador, web_app, "Acessa e preenche formulários", "HTTP / Navegador")
Rel(web_app, backend, "Envia dados dos formulários e solicita relatórios", "HTTP / JSON")
Rel(backend, database, "Lê e grava informações no banco", "SQL")

@endluml
